rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notices/{noticeId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 6);
    }

    match /notice_meta/{documentId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 6);
    }
  }
}
