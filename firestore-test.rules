rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1
        );
    }

    match /notice_meta/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      function isOwner() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function validQuestion() {
        return request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.type in ['배송문의', '계정문의', '교환/환불', '시스템오류', '기타']
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.isPrivate is bool
          && request.resource.data.answer is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      allow get, list: if resource.data.get('isPrivate', false) == false || isOwner() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'title', 'type', 'content', 'isPrivate', 'authorId',
          'answer', 'answeredAt', 'answeredBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'type', 'content', 'isPrivate', 'authorId',
          'answer', 'answeredAt', 'answeredBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.answer == ''
        && request.resource.data.answeredAt == ''
        && request.resource.data.answeredBy == ''
        && validQuestion();
      allow update: if (
        isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'type', 'content', 'isPrivate', 'updatedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.answer == resource.data.answer
        && request.resource.data.answeredAt == resource.data.answeredAt
        && request.resource.data.answeredBy == resource.data.answeredBy
        && validQuestion()
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'answeredAt', 'answeredBy'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 5000
        && request.resource.data.answeredAt is string
        && request.resource.data.answeredBy == request.auth.uid
      );
      allow delete: if isOwner();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'username', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username.matches('^[a-z0-9._-]{3,20}$')
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update, delete: if false;
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
  }
}
